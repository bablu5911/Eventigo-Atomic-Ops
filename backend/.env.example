# Atomic Ops Backend Environment Variables

PORT=5000
NODE_ENV=development

# Frontend Client URL(s) for CORS (comma-separated if multiple, e.g. http://localhost:3000,https://atomic-ops.vercel.app)
CLIENT_URL=http://localhost:3000

# MongoDB Database URI (Leave empty to use automatic zero-dependency In-Memory database)
MONGODB_URI=mongodb://127.0.0.1:27017/atomic-ops

# Security Keys
JWT_SECRET=atomic_ops_jwt_secret_key_2026_super_secure_spec
JWT_REFRESH_SECRET=atomic_ops_refresh_token_secret_key_2026_spec
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Optional Cloudinary Configuration for Image Uploads
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Optional Email SMTP Settings
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# FROM_EMAIL=noreply@atomicops.com
