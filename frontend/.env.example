# Atomic Ops Frontend Environment Variables

# Backend API Endpoint URL (include /api or base domain)
# In Development: http://localhost:5000/api
# In Production: https://your-backend-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Optional Google OAuth Client ID
# VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional Apple Service ID
# VITE_APPLE_CLIENT_ID=com.yourdomain.atomicops
